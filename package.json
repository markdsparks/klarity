{
  "name": "klarity",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~56.0.18",
    "@react-native-ai/apple": "^0.12.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "ai": "^6.0.219",
    "expo": "~56.0.12",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.21",
    "expo-font": "~56.0.7",
    "expo-image": "~56.0.11",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.11",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.19",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-worklets": "0.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eas-cli": "^20.4.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "test": "jest --watchAll=false",
    "test:watch": "jest",
    "build:local": "bash scripts/build-local-ios.sh",
    "submit:local": "eas submit --platform ios --profile preview --path ios/build/export/Klarity.ipa --non-interactive",
    "build:preview": "eas build --platform ios --profile preview",
    "build:sim": "eas build --platform ios --profile development",
    "build:device": "eas build --platform ios --profile development-device",
    "submit:ios": "eas submit --platform ios --profile preview --latest",
    "golden": "tsx scripts/export-data.ts && tsx scripts/gen-golden.ts && tsx scripts/gen-golden-network.ts",
    "test:swift": "swift test --package-path swift/KlarityCore",
    "native:gen": "bash scripts/native-secrets.sh && cd native && xcodegen generate --quiet",
    "build:native": "bash scripts/build-native-ios.sh",
    "submit:native": "eas submit --platform ios --profile preview --path native/build/export/Klarity.ipa --non-interactive"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/src/__tests__/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/worktrees/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/(?!(use-latest-callback))|react-navigation|@react-navigation/.*)"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ]
  },
  "private": true
}
